# Stripe: https://dashboard.stripe.com/apikeys  (use sk_test_... until you're ready)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or Dashboard > Developers > Webhooks in production
STRIPE_WEBHOOK_SECRET=whsec_xxx
BASE_URL=http://localhost:8000
STORE_NAME=My Store
# Protects GET /admin/orders (send "Authorization: Bearer <token>")
ADMIN_TOKEN=change-me
# Physical products (3D-printed figures)
SHIPPING_CENTS=599
SHIP_COUNTRIES=US
# Where new print orders are emailed (needs SMTP below)
OWNER_EMAIL=
MAX_DOWNLOADS=5
LINK_TTL_HOURS=72
# Email: download links, order confirmations, shipping notices, print orders to you
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
