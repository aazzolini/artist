# Stripe: https://dashboard.stripe.com/apikeys  (use sk_test_... until you're ready)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or Dashboard > Developers > Webhooks in production
STRIPE_WEBHOOK_SECRET=whsec_xxx
BASE_URL=http://localhost:8000
STORE_NAME=My Store
# Protects GET /admin/orders (send "Authorization: Bearer <token>")
ADMIN_TOKEN=change-me
MAX_DOWNLOADS=5
LINK_TTL_HOURS=72
# Optional: email the download link to buyers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
